#!/bin/sh
set -eu
first_line=$(head -n 1 "$1")
case "$first_line" in
  Merge*|merge:*) exit 0 ;;
esac
if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]*\))?!?: .+'; then
  printf '%s\n' 'Use a Conventional Commit subject such as feat(model): validate weights.' >&2
  exit 1
fi
